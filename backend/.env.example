# By default TradeFrame uses the local SQLite DB at ..\data\tradeframe.sqlite3.
# TRADEFRAME_DATABASE_URL=sqlite:///D:/Path/To/TradeFrame/data/tradeframe.sqlite3
# Optional override. By default TradeFrame uses %LOCALAPPDATA%\AlecaFrame.
# TRADEFRAME_ALECA_DATA_DIR=C:\Users\YourName\AppData\Local\AlecaFrame
